# Copy to .env and fill in. .env is gitignored - never commit real keys.
#   cp .env.example .env
#
# Nothing here is needed to run the gateway in mock mode, which is the
# default. A fresh clone runs with no key at all.

# --- how we talk to the model ----------------------------------------------
# mock   = fixed reply, no network, no key. The default.
# replay = a reply recorded earlier, read from data/cassettes. No money.
# live   = a real OpenAI call. Needs the key below.
PROVIDER_MODE=mock
# Set to on with PROVIDER_MODE=live to save each reply as a cassette,
# so the same run can be replayed for free afterwards.
PROVIDER_RECORD=off

# We use OpenRouter, which is OpenAI-compatible: same request body, one base
# URL change, and model names are slugs like openai/gpt-4o-mini.
# Get a key at https://openrouter.ai/keys (it starts with sk-or-).
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-4o-mini
# For real OpenAI instead: key sk-..., base https://api.openai.com/v1, model gpt-4o-mini.

# Hard stop on spending, checked before every live call. A sweep is a loop
# that fires hundreds of prompts, so this is not optional.
SPEND_CAP_USD_PER_DAY=2.0

# --- the experiment switches ------------------------------------------------
# These are the whole point. The vulnerable baseline and the defended build
# are the same code with different values here, and every log line records
# which values produced it.
#
# cache_first = what real products do, and the hole we are proving.
PIPELINE_ORDER=cache_first
# off = Phase 2 baseline. on = the Phase 3 defence.
CACHE_VERDICT_FILTER=off
CACHE_REVERIFY_HIGH_RISK=off
# Phase 3 defence knobs. A risky kind of question needs this close a match.
CACHE_STRICT_THRESHOLD=0.95
# A cached answer whose stored injection score is at least this is re-checked.
REVERIFY_SCORE=0.2
# risky = re-check only risky-looking hits (fast). all = re-check every hit (safe).
REVERIFY_SCOPE=risky
# Phase 3 router. fixed = always the requested model. difficulty = easy
# questions to the cheap model, hard ones (score >= ROUTER_HARD_SCORE) to the strong one.
ROUTER_MODE=fixed
ROUTER_CHEAP_MODEL=openai/gpt-4o-mini
ROUTER_STRONG_MODEL=openai/gpt-4o
ROUTER_HARD_SCORE=0.4
# If the chosen model's call fails, try this one once. Empty = off.
FALLBACK_MODEL=
# Phase 3 output guard: scan every answer, cache hits too, for script, SQL,
# shell and secrets. off | flag (serve, mark it) | block (refuse, never cache).
OUTPUT_GUARD=off
# Phase 3 per-caller limits. 0 = off. Counts live in Redis when it is there.
RATE_LIMIT_RPM=0
TOKEN_BUDGET_PER_DAY=0
SIM_THRESHOLD=0.85
# Week 2 screening. stub = keyword stand-in, no models. auto = try deberta,
# fall back to stub so the gateway always starts. hf = force the real model.
INJECTION_THRESHOLD=0.5
SCREENING_SCORER=auto

# Week 3 baseline cache. Deliberately vulnerable: verdict stored, not checked.
# CACHE_BACKEND=memory keeps the gateway running with no infra. auto tries
# Redis+Qdrant first, falls back to memory.
EMBED_MODEL=all-MiniLM-L6-v2
CACHE_EMBEDDER=auto
CACHE_BACKEND=auto

# --- infrastructure ---------------------------------------------------------
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# Optional - only if you hit HuggingFace rate limits pulling models.
# HF_TOKEN=hf_...

# Phase 3 Week 3 adds Anthropic as the failover provider.
# ANTHROPIC_API_KEY=sk-ant-...
