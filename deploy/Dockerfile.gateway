# The Phase 2 gateway.
#
# Models are NOT baked in. They download on first use in hf mode, or the stub
# runs with no download at all. Keeping them out of the image means a code
# change does not rebuild hundreds of MB.
# They land in /models, which compose mounts as a volume, so they download
# once and survive every restart.

FROM python:3.11-slim

# The running service reports which commit it is, and every log line carries
# it. Inside a container there is no git repo to ask, so it is passed in.
ARG BUILD_SHA=unknown
ENV SENTRYGATE_BUILD_SHA=${BUILD_SHA} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SENTRYGATE_DATA_DIR=/data \
    HF_HOME=/models \
    HF_HUB_DISABLE_PROGRESS_BARS=1 \
    TRANSFORMERS_VERBOSITY=error \
    TOKENIZERS_PARALLELISM=false

WORKDIR /app

# Torch CPU first, from its own index: MiniLM needs no GPU and the full CUDA
# wheel would triple the image. Then everything else from PyPI.
COPY requirements-gateway.txt .
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.5.1 \
 && pip install --no-cache-dir -r requirements-gateway.txt

COPY app/ app/

# Do not run as root. The data directory is a mount, so it is chowned here
# and the volume keeps the ownership.
RUN useradd --create-home --uid 10001 sentry \
 && mkdir -p /data /models \
 && chown -R sentry:sentry /data /models /app
USER sentry

EXPOSE 8000

# No curl in a slim image, so the check uses python.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2).status==200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
